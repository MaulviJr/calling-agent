{
  "name": "ava-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build --webpack",
    "start": "node server.mjs --production",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write app components lib server.mjs next.config.ts postcss.config.mjs",
    "format:check": "prettier --check app components lib server.mjs next.config.ts postcss.config.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "http-proxy": "^1.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0"
  }
}
