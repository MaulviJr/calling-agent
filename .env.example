DEEPGRAM_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
DATABASE_URL=postgresql+psycopg://ava:change-me@localhost:5432/ava
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Voice turn detection: longer silence timeout tolerates pauses but delays replies.
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=2000

# Read-only Vapi milestone. Existing custom voice settings remain separate.
# Generate a random token (at least 32 characters); never use a Vapi API key here.
VAPI_WEBHOOK_TOKEN=
# Saved Vapi assistant IDs -> existing Ava Business IDs; configured server-side.
VAPI_ASSISTANT_BUSINESS_MAP={}
VAPI_PUBLIC_BASE_URL=
# Vapi Custom Credential with Authorization: Bearer <VAPI_WEBHOOK_TOKEN>.
VAPI_SERVER_CREDENTIAL_ID=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_ELEVENLABS_VOICE_ID=
VAPI_ELEVENLABS_MODEL=eleven_flash_v2_5
VAPI_FIRST_MESSAGE=Hi, this is Ava. How can I help?
# Optional saved Tool resources, visible in the Vapi dashboard. Set both or neither.
VAPI_BUSINESS_TOOL_ID=
VAPI_STAFF_TOOL_ID=
# Appointment/message tools; keep false to run only the read-only milestone.
VAPI_ACTIONS_ENABLED=false
# Business that owns GOOGLE_CALENDAR_ID. Other tenants fail closed on calendar tools.
VAPI_CALENDAR_BUSINESS_ID=
# Saved IDs for the seven additional tools; written by tool provisioning.
VAPI_ACTION_TOOL_IDS={}

